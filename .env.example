# ==============================================================================
# VAULTORY CONFIGURATION TEMPLATE
# Copy this file to .env and configure the values as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ESSENTIAL CONFIGURATION (Required to run Vaultory)
# ------------------------------------------------------------------------------
# Port for the Node.js/Express full-stack backend server
PORT=5050

# Node execution environment (development | production)
NODE_ENV=development

# Secret key used to sign and verify JSON Web Tokens (JWT) for authentication
# Generate a random 32+ character string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# ------------------------------------------------------------------------------
# 2. AI PROVIDER: GOOGLE GEMINI API (Recommended for Document Extraction)
# ------------------------------------------------------------------------------
# Used for structured invoice, receipt, and warranty card entity extraction,
# and enhanced conversational Q&A grounded in your stored purchase records.
#
# Obtain a free API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
#
# If left blank, Vaultory automatically runs in local deterministic mode
# using Tesseract OCR and native document parsers.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (For Gmail Purchase Document Discovery)
# ------------------------------------------------------------------------------
# Allows users to connect their Gmail account to discover purchase-related emails
# and invoices without storing or asking for mailbox passwords.
#
# Create credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# - Authorized JavaScript origins: http://localhost:5050, http://localhost:5173
# - Authorized redirect URI: http://localhost:5050/api/email/oauth/google/callback
#
# If left blank, email integration will display as "Not Configured" in the UI,
# while File Upload and Gallery import remain 100% operational.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5050/api/email/oauth/google/callback

# ------------------------------------------------------------------------------
# 4. SUPABASE CLOUD DATABASE & STORAGE (Optional)
# ------------------------------------------------------------------------------
# Vaultory stores records in a local persistent SQLite database (data/vaultory.db)
# and files in uploads/ by default.
#
# If you want to connect to a hosted Supabase PostgreSQL database and S3-compatible
# storage bucket, create a project at https://supabase.com and provide:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET=vaultory-documents
